# Legal Skills — example environment file.
#
# The app needs NO configuration to run: `npm install && npm run dev` works with
# this file absent. There are no API keys, because the project does not call any
# LLM provider or backend. Copy to `.env` only if you want to override a link.

# Repository URL used by the header and footer links.
# Set this when you fork, so the links point at your repo rather than upstream.
VITE_REPO_URL=https://github.com/sahil1115/legal-skills

# Base public path for the build. Defaults to './' (relative), which works for
# GitHub Pages project sites and any subdirectory. Set an absolute path only if
# your host requires one, e.g. VITE_BASE=/legal-skills/
# VITE_BASE=./
