# Legal Skills — example environment file.
#
# The app needs NO configuration to run: `npm install && npm run dev` works with
# this file absent. There are no API keys and no secrets here — every value is
# public and baked into the static build. Copy to `.env` to override.

# Repository URL used by the header and footer links.
# Set this when you fork, so the links point at your repo rather than upstream.
VITE_REPO_URL=https://github.com/sahil1115/legal-skills

# --- Analytics (optional) ----------------------------------------------------
#
# Plausible Analytics: cookieless, no personal data, no cross-site tracking.
# LEAVE THIS UNSET TO DISABLE ANALYTICS COMPLETELY — no script is loaded and no
# request is made. That is the default for a fresh clone.
#
# Set it to the domain exactly as registered in your Plausible dashboard.
# For a GitHub Pages project site, that includes the repository path:
VITE_PLAUSIBLE_DOMAIN=example.github.io/legal-skills

# Optional: point at a self-hosted Plausible instance.
# Defaults to https://plausible.io when unset.
# VITE_PLAUSIBLE_HOST=https://plausible.example.com

# --- Build -------------------------------------------------------------------
#
# Base public path. Defaults to './' (relative), which works for GitHub Pages
# project sites and any subdirectory. Set an absolute path only if your host
# requires one, e.g. VITE_BASE=/legal-skills/
# VITE_BASE=./
